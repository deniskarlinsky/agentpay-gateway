# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key
**/signing-key*
.local/

# ── Java / Gradle ──────────────────────────────────────────────────────────────
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# ── IDE ────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.class

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker / ops ──────────────────────────────────────────────────────────────
ops/traces/*
!ops/traces/.gitkeep

# ── Evals output ──────────────────────────────────────────────────────────────
evals/results/*
!evals/results/.gitkeep

# ── Claude Code ───────────────────────────────────────────────────────────────
# Ignore .claude/ contents but re-include the hooks dir so shared hook scripts
# (cross-platform jq guards, stack-policy checks) can be tracked.
.claude/*
!.claude/hooks/

# ── Stray run/test logs at repo root ──────────────────────────────────────────
/combinedTest.log
/fullOrch.log
/scenarioA.log
/tmp_handoff_status.txt
*.log.bak
